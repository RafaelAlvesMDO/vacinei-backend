# Configurações do Servidor
PORT=3333
NODE_ENV=development

# Configuração do PostgreSQL (Prisma ORM)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vacinei_db?schema=public"

# Autenticação JWT (para próximos módulos)
JWT_SECRET="seu-jwt-secret-super-seguro"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# E-mail (SMTP) - se não configurado, o conteúdo é exibido no console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_usuario_smtp
SMTP_PASS=sua_senha_smtp
MAIL_FROM="VACINEI!? <no-reply@vacinei.app>"

# Microsserviço de OCR da caderneta (D25 / D34), serviço ocr-api do docker-compose
OCR_SERVICE_URL=http://localhost:8000
OCR_TIMEOUT_MS=20000
OCR_MAX_IMAGE_MB=8

# Prova de conceito do OCR (docker compose --profile ocr). Pastas FORA do repositório.
# No Windows, use barras normais. Se não definir, usa ocr-service/amostras e ocr-service/saida (ignoradas pelo Git).
OCR_SAMPLES_DIR=C:/caminho/para/ocr-fotos
OCR_OUTPUT_DIR=C:/caminho/para/ocr-fotos-saida
